# Host-side Synopsys shims (vcs / xmake / xrepo -> eda-shim, forwarding into a container).
#
# The directory guard is the whole point: on a machine without the shims (no container, no
# ~/.synopsys/bin) this file changes nothing, so `just smoke` / `just examples` degrade exactly as
# documented in AGENTS.md ("without VCS/IES tests/svdpi/run.sh prints SKIP"). A dotenv-style .env
# cannot express that condition, which is why this is an .envrc. `PATH_add` (not a bare
# `export PATH=`) keeps the entry unique and re-evaluates against the pre-directory environment.
#
# direnv: `direnv allow` once; every edit re-arms that requirement (allow is content-hash based).
if [ -d "$HOME/.synopsys/bin" ]; then
  PATH_add "$HOME/.synopsys/bin"
fi
